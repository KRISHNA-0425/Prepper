# Judge0 CE Environment Configuration Example
# Copy this or refer to judge0.conf for local self-hosting configuration.

# Network & Server Port
PORT=2358
JUDGE0_TELEMETRY_ENABLE=false

# Redis Credentials
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMeRedisPassword123!

# PostgreSQL Credentials
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=ChangeMePostgresPassword123!

# Submission Limits
CPU_TIME_LIMIT=5.0
CPU_EXTRA_TIME=1.0
WALL_TIME_LIMIT=10.0
MEMORY_LIMIT=128000
MAX_QUEUE_SIZE=100
MAX_PROCESS_COUNT=64
